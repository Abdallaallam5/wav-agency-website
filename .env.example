# Copy to .env for local development. On Vercel, add the same names under Project Settings > Environment Variables.
# Leads are emailed from this mailbox. SMTP_PASS must be a Google "App Password", not the normal password.
SMTP_USER=wavagency.eg@gmail.com
SMTP_PASS=
# Optional: where leads are delivered (defaults to SMTP_USER)
LEADS_TO=

# Optional: also create each lead in the WAV CRM (crm/backend). CRM_URL has no trailing /api.
# Get the key from the CRM backend log on first start, or set WEBSITE_KEY in its .env.
CRM_URL=
CRM_WEBSITE_KEY=
