PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017
# Database name used for the CRM (created if missing).
MONGO_DB=wav-crm

# First admin, created automatically when the users collection is empty.
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_EMAIL=kareemgulf5@gmail.com
ADMIN_NAME=Kareem Saad
ADMIN_PASSWORD=

# Signs session tokens. If empty, one is generated and stored in MongoDB.
JWT_SECRET=
# Shared secret the WAV website sends with each lead. If empty, one is generated and printed at startup.
WEBSITE_KEY=

# Only needed when the frontend is hosted on a different domain (comma separated).
CLIENT_ORIGIN=

# Public address of this CRM, used for links inside emails (e.g. https://crm.wavagency.com).
CRM_PUBLIC_URL=

# Email (client answers from the portal + the daily summary). Same Gmail App Password as the website.
SMTP_USER=wavagency.eg@gmail.com
SMTP_PASS=

# Daily summary: Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Any long random text.
CRON_SECRET=

# Meta Lead Ads webhook (/api/meta). Leave empty to keep it off.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
# Optional: email of the teammate who owns new Meta leads.
META_LEAD_OWNER=
